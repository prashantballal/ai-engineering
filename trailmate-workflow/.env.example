# Copy to .env (`cp .env.example .env`) and adjust. .env is gitignored. Never commit it.
# Every variable is optional; the defaults are shown.

LOG_LEVEL=INFO

# --- LiteLLM proxy (Day 3) -----------------------------------------------------------
# REQUIRED: LiteLLM 1.110 refuses to start without a strong master key. Generate YOUR OWN
# key once (never share or commit it) by running this in trailmate-workflow/:
#   printf 'LITELLM_MASTER_KEY=sk-%s\n' "$(openssl rand -hex 32)" >> .env
# The proxy reads it via litellm/config.yaml (os.environ/LITELLM_MASTER_KEY), and the app
# sends it as "Authorization: Bearer ..." (LITELLM_API_KEY, falling back to LITELLM_MASTER_KEY).
# LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}

# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# TRAIL_TIER=smart
# GENERAL_TIER=fast
# MODEL_TIMEOUT_S=60
# MODEL_MAX_RETRIES=1
# MODEL_MAX_TOKENS=300
# MODEL_TEMPERATURE=0.3
